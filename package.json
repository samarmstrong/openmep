{
  "name": "openmep",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @openmep/web --",
    "dev:web": "npm run dev --workspace @openmep/web --",
    "dev:worker": "npm run dev --workspace @openmep/worker --",
    "build": "npm run build --workspace @openmep/hvac-domain && npm run build --workspace @openmep/agent-benchmark && npm run build --workspace @openmep/model-core && npm run build --workspace @openmep/web && npm run build --workspace @openmep/worker",
    "test": "npm run test --workspace @openmep/hvac-domain && npm run test --workspace @openmep/agent-benchmark && npm run test --workspace @openmep/model-core && npm run test --workspace @openmep/web",
    "benchmark:verify": "npm run verify --workspace @openmep/agent-benchmark",
    "pack:public": "npm pack --dry-run --workspace @openmep/hvac-domain && npm pack --dry-run --workspace @openmep/agent-benchmark",
    "lint": "npm run lint --workspace @openmep/web",
    "db:init": "tsx packages/model-core/src/scripts/init-db.ts",
    "eval:materialize": "tsx packages/model-core/src/scripts/eval-materialize.ts",
    "eval:prepare": "tsx packages/model-core/src/scripts/eval-prepare.ts",
    "eval:grade": "tsx packages/model-core/src/scripts/eval-grade.ts",
    "eval:run": "tsx packages/model-core/src/scripts/eval-run.ts",
    "seed:sample": "tsx packages/model-core/src/scripts/seed-sample.ts",
    "seed:dev-fixture": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs packages/model-core/src/scripts/seed-dev-fixture.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
