# PostgreSQL (npm run db:init creates the schema)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mep
# Base URL the web app is served from (apps/web/scripts/dev.mjs defaults to port 3001)
PUBLIC_BASE_URL=http://localhost:3001
# fs | s3
STORAGE_DRIVER=fs
LOCAL_STORAGE_ROOT=./artifacts
# Required when STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
PG_BOSS_SCHEMA=pgboss
# Space-type classification and the headless eval runner call Claude
# ANTHROPIC_API_KEY=
# Set to 1 to skip seeding the public Duplex fixture on `npm run dev:web`
# MEP_SKIP_DEV_FIXTURE=0
