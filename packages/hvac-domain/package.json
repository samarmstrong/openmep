{
  "name": "@openmep/hvac-domain",
  "version": "0.3.1",
  "description": "Deterministic round-duct sizing and supply-network propagation, as a library and a host-free CLI (openmep-hvac).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "openmep-hvac": "bin/openmep-hvac.js"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mep",
    "hvac",
    "duct-sizing",
    "ashrae",
    "equal-friction"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "size:example": "node ./bin/openmep-hvac.js size examples/furnace-two-registers.items.json --pretty"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
