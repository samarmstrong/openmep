{
  "name": "@openmep/mcp",
  "version": "0.1.0",
  "mcpName": "io.github.samarmstrong/openmep",
  "description": "MCP server for OpenMEP's deterministic HVAC duct sizing: size one run or a whole supply/return network from any agent, no editor required.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samarmstrong/openmep.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "openmep-mcp": "bin/openmep-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mep",
    "hvac",
    "duct-sizing",
    "mcp",
    "model-context-protocol",
    "ashrae"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openmep/hvac-domain": "0.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
