{
  "name": "@openmep/pascal-adapter",
  "version": "0.3.0",
  "description": "Size and check HVAC duct systems in Pascal Editor scenes with OpenMEP's deterministic engine; emits apply_patch batches.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "openmep-pascal": "bin/openmep-pascal.js"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mep",
    "hvac",
    "duct-sizing",
    "pascal",
    "pascal-editor",
    "mcp"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "size:example": "node ./bin/openmep-pascal.js size examples/furnace-two-registers.json --pretty",
    "live:roundtrip": "node ./examples/live-roundtrip.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openmep/hvac-domain": "0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "zod": "^4.6.0"
  }
}
